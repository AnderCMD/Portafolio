{
	"name": "andercmd-link-redirector",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "0aac14ada6184e2c971319e560dc02fe"
		}
	],
	"routes": [
		{ "pattern": "andercmd.link/*", "zone_name": "andercmd.link" },
		{ "pattern": "www.andercmd.link/*", "zone_name": "andercmd.link" }
	]
}
