---
export const prerender = false;

import AdminLayout from '@layouts/AdminLayout.astro';
import { SESSION_COOKIE, verifySessionToken } from '@lib/shortener/auth';

const token = Astro.cookies.get(SESSION_COOKIE)?.value;
if (verifySessionToken(token)) {
	return Astro.redirect('/Admin');
}

const hasError = Astro.url.searchParams.get('error') === '1';
---

<AdminLayout title="Iniciar sesión">
	<div class="flex min-h-[70vh] items-center justify-center">
		<form
			method="POST"
			action="/api/admin/login"
			class="glass card-modern w-full max-w-sm space-y-5 rounded-2xl p-8 shadow-lg"
		>
			<div class="text-center">
				<span class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-linear-to-br from-sky-500 to-blue-600 text-white shadow-lg shadow-sky-500/30">
					<i class="fa-solid fa-link text-xl" aria-hidden="true"></i>
				</span>
				<h1 class="text-xl font-bold text-slate-900 dark:text-white">Acceso administrador</h1>
				<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Panel del acortador de andercmd.link</p>
			</div>

			{hasError && (
				<p
					class="flex items-center gap-2 rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-2.5 text-sm text-red-600 dark:text-red-300"
					role="alert"
				>
					<i class="fa-solid fa-circle-exclamation" aria-hidden="true" />
					Usuario o contraseña incorrectos.
				</p>
			)}

			<label class="block text-sm font-medium text-slate-700 dark:text-slate-300">
				Usuario
				<div class="relative mt-1.5">
					<i
						class="fa-solid fa-user pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-slate-400"
						aria-hidden="true"
					></i>
					<input
						type="text"
						name="username"
						required
						autocomplete="username"
						class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pr-4 pl-10 text-slate-900 transition-all focus:border-sky-500 focus:ring-2 focus:ring-sky-500/30 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
					/>
				</div>
			</label>

			<label class="block text-sm font-medium text-slate-700 dark:text-slate-300">
				Contraseña
				<div class="relative mt-1.5">
					<i
						class="fa-solid fa-lock pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-slate-400"
						aria-hidden="true"
					></i>
					<input
						type="password"
						name="password"
						required
						autocomplete="current-password"
						class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pr-4 pl-10 text-slate-900 transition-all focus:border-sky-500 focus:ring-2 focus:ring-sky-500/30 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
					/>
				</div>
			</label>

			<button
				type="submit"
				class="btn-modern w-full rounded-xl bg-linear-to-r from-sky-500 to-blue-600 px-6 py-3 font-bold text-white shadow-lg shadow-sky-500/30 transition-all duration-300 hover:scale-[1.02] hover:from-sky-600 hover:to-blue-700 hover:shadow-xl hover:shadow-sky-500/40 active:scale-95"
			>
				<i class="fa-solid fa-right-to-bracket mr-2" aria-hidden="true"></i>Entrar
			</button>
		</form>
	</div>
</AdminLayout>
