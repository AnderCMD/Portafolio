# Copia este archivo a .env para desarrollo local. NUNCA subas .env real al repo.
# En producción estas variables se configuran como Node.js Environment
# Variables del sitio, no en el código ni en el repositorio.

# Base de datos MySQL del acortador (Hostinger > Bases de datos)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Credenciales del panel /admin.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Secreto usado para firmar la cookie de sesión del panel (32+ bytes aleatorios).
SESSION_SECRET=
