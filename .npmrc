# Configuración específica para despliegues automáticos en Hostinger PaaS / VPS
#
# IMPORTANTE: `ignore-scripts` debe permanecer en `true`. Se probó ponerlo en
# `false` (confiando solo en la allowlist de pnpm-workspace.yaml) y el deploy
# en Hostinger se rompió: el postinstall de `esbuild` (que valida el binario
# nativo ejecutándolo) revienta con EACCES porque, en el entorno de build de
# Hostinger, los binarios de paquetes nativos llegan SIN permiso de
# ejecución. Ese fallo ocurre DURANTE `pnpm install`, antes de que el script
# `build` (que hace `chmod -R +x node_modules/...`) tenga oportunidad de
# corregir los permisos. `ignore-scripts=true` salta ese postinstall que
# revienta; el chmod manual en el script `build` es el que realmente deja los
# binarios ejecutables antes de compilar. No lo cambies a `false` a menos que
# confirmes que Hostinger ya preserva el bit +x de los paquetes con binarios
# nativos.
ignore-scripts=true

# Utiliza una estructura de node_modules plana (evita problemas de permisos con enlaces simbólicos en Hostinger)
node-linker=hoisted
