# Configuración específica para despliegues automáticos en Hostinger PaaS / VPS
#
# IMPORTANTE: `ignore-scripts` debe permanecer en `false` (o ausente). Si se
# pone en `true` bloquea TODOS los scripts de instalación sin excepción, lo
# que anula por completo la allowlist de `pnpm-workspace.yaml`
# (`onlyBuiltDependencies`) y lo que apruebe `pnpm approve-builds` — esa
# combinación era la causa de que esbuild fallara con EACCES en Hostinger
# (su postinstall nunca se ejecutaba para dejar el binario con permisos de
# ejecución). Con `onlyBuiltDependencies` en pnpm-workspace.yaml, pnpm ya
# omite por defecto los scripts de cualquier paquete no aprobado, así que no
# hace falta el bloqueo global.
ignore-scripts=false

# Utiliza una estructura de node_modules plana (evita problemas de permisos con enlaces simbólicos en Hostinger)
node-linker=hoisted
